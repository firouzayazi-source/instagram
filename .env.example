# کپی کنید به .env و مقدارها را پر کنید. فایل .env هرگز در ریپو نمی‌رود.
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_VERSION=v21.0
DB_PATH=/opt/igbot/data/bot.db
SEND_DELAY_MIN=2
SEND_DELAY_MAX=8

# پنل
PANEL_PASSWORD=
SESSION_TTL=2592000
COOKIE_SECURE=1

# اعلان پوش: python -m app.push --gen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@stland.ir
