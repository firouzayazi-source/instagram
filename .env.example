# کپی کنید به .env و مقدارها را پر کنید. فایل .env هرگز در ریپو نمی‌رود.
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_VERSION=v21.0
DB_PATH=/opt/igbot/data/bot.db
SEND_DELAY_MIN=2
SEND_DELAY_MAX=8

# همگام‌سازی محصول از ووکامرس: فقط اگر Store API عمومی سایت بسته بود.
# ووکامرس ← تنظیمات ← پیشرفته ← REST API ← کلید با دسترسی «خواندن»
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# پنل
PANEL_PASSWORD=
SESSION_TTL=2592000
COOKIE_SECURE=1

# اعلان پوش: python -m app.push --gen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@stland.ir

# پاسخ هوشمند: فقط کلید سرویس‌هایی که دارید را پر کنید. سرویس و مدل از پنل انتخاب می‌شود.
# AI_PROVIDER و AI_MODEL فقط مقدار پیش‌فرض‌اند: anthropic | openai | gemini | deepseek | openrouter | custom
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# هر سرویس سازگار با OpenAI، مثلاً https://example.ir/v1 (کلید برای Ollama لازم نیست)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_NAME=

# ربات تلگرام (tgbot/): توکن از BotFather، آیدی عددی مدیرها با کاما (اولی مالک است)
BOT_TOKEN=
ADMIN_ID=
