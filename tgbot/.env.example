# این فایل را کپی کنید به .env و مقداردهی کنید — هرگز .env واقعی را کامیت نکنید.
#
# ربات هیچ پورتی روی سرور باز نمی‌کند و فقط به تلگرام وصل می‌شود،
# پس با هیچ پروژه‌ی دیگری روی همان وی‌پی‌اس تداخل ندارد.

# توکن ربات از BotFather
BOT_TOKEN=

# آیدی عددی مدیر تلگرام (از @userinfobot بگیرید)
#
# برای چند مدیر با کاما جدا کنید:
#     ADMIN_ID=11111111,22222222
# اولین آیدی «مالک» است: فقط او می‌تواند مدیر اضافه/کم کند و بک‌آپ را
# بازگرداند. بقیه به پنل و پیام‌های مشتری‌ها دسترسی دارند.
# مدیر را از داخل پنل هم می‌شود اضافه کرد (تنظیمات ← مدیران ربات).
ADMIN_ID=
