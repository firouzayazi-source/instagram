# ---- Instagram (Meta App -> Instagram -> API setup with Instagram login) ----
# Long-lived Instagram user access token
IG_ACCESS_TOKEN=
# Instagram professional account ID (17841...)
IG_USER_ID=
# Instagram app secret, used to verify webhook signatures
IG_APP_SECRET=
# Any random string; type the same value in the Meta webhook settings
IG_VERIFY_TOKEN=
# IG_API_VERSION=v23.0

# ---- Telegram (@BotFather) ----
TELEGRAM_BOT_TOKEN=
# Leave empty at first, send /start to the bot and it replies with the number
TELEGRAM_ADMIN_CHAT_ID=
# Any random string (letters, digits, _ and -)
TELEGRAM_WEBHOOK_SECRET=

# ---- Claude (console.anthropic.com) ----
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---- Server ----
# Domain pointed at this server (used by Caddy for the HTTPS certificate), e.g. bot.example.com
DOMAIN=
# Public HTTPS address of this server, no trailing slash
PUBLIC_URL=
# DATA_DIR=data
# DM_WINDOW_HOURS=24
